+static int cmd_miniapp(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+
+    if (argc < 2) {
+        shellPrint(shell, "usage:\r\n");
+        shellPrint(shell, "  miniapp list          list builtin apps\r\n");
+        shellPrint(shell, "  miniapp run <id>      install + launch a builtin app\r\n");
+        shellPrint(shell, "  miniapp status        runtime counters / last Lua error\r\n");
+        shellPrint(shell, "  miniapp key <dir> <0|1>  inject up/down/left/right key\r\n");
+        shellPrint(shell, "  miniapp btn           simulate side function key click\r\n");
+        shellPrint(shell, "  miniapp screen        dump the last presented frame\r\n");
+        shellPrint(shell, "  miniapp glyph <hex>.. dump font glyph bitmap for codepoints\r\n");
+        return -1;
+    }
+
+    if (strcmp(argv[1], "glyph") == 0) {
+        /* 字形自检：确认某个码位在 lv_font_chinese_16 里真的有字形，并把位图打成点阵。
+         * 用途：验证 ↑↓←→ 这类符号是否可用、朝向是否正确。 */
+        if (argc < 3) {
+            shellPrint(shell, "usage: miniapp glyph 2191 2193  (hex codepoints)\r\n");
+            return -1;
+        }
+        for (int i = 2; i < argc; ++i) {
+            uint32_t cp = (uint32_t)strtoul(argv[i], NULL, 16);
+            lv_font_glyph_dsc_t g;
+            memset(&g, 0, sizeof(g));
+            if (!lv_font_get_glyph_dsc(&lv_font_chinese_16, &g, cp, 0)) {
+                shellPrint(shell, "U+%04lX: no glyph\r\n", (unsigned long)cp);
+                continue;
+            }
+            shellPrint(shell, "U+%04lX box=%dx%d ofs=(%d,%d) adv=%d\r\n", (unsigned long)cp,
+                       (int)g.box_w, (int)g.box_h, (int)g.ofs_x, (int)g.ofs_y, (int)g.adv_w);
+            const uint8_t *bmp = lv_font_get_glyph_bitmap(&lv_font_chinese_16, cp);
+            if (!bmp) {
+                shellPrint(shell, "  <no bitmap>\r\n");
+                continue;
+            }
+            char line[48];
+            int n = g.box_w < 40 ? (int)g.box_w : 40;
+            for (int y = 0; y < (int)g.box_h && y < 24; ++y) {
+                for (int x = 0; x < n; ++x) {
+                    uint32_t bit = (uint32_t)y * (uint32_t)g.box_w + (uint32_t)x;
+                    line[x] = ((bmp[bit >> 3] >> (7 - (bit & 7))) & 1) ? '#' : '.';
+                }
+                line[n] = '\0';
+                shellPrint(shell, "  %s\r\n", line);
+            }
+        }
+        return 0;
+    }
+
+    if (strcmp(argv[1], "key") == 0) {
+#ifdef CONFIG_MINIAPP_ADB_DEBUG
+        if (argc < 4) {
+            shellPrint(shell, "usage: miniapp key <up|down|left|right> <0|1>\r\n");
+            return -1;
+        }
+        char bank = 0;
+        int pin = 0;
+        /* 引脚与丝印方向是交叉的（2026-11 实测）：上=PB7 下=PA0 左=PB6 右=PA1 */
+        if (strcmp(argv[2], "up") == 0) {
+            bank = 'b'; pin = 7;
+        } else if (strcmp(argv[2], "left") == 0) {
+            bank = 'b'; pin = 6;
+        } else if (strcmp(argv[2], "right") == 0) {
+            bank = 'a'; pin = 1;
+        } else if (strcmp(argv[2], "down") == 0) {
+            bank = 'a'; pin = 0;
+        } else {
+            shellPrint(shell, "unknown key '%s'\r\n", argv[2]);
+            return -1;
+        }
+        int level = atoi(argv[3]) ? 1 : 0;
+        if (miniapp_debug_set_pin(bank, pin, level) != 0) {
+            shellPrint(shell, "inject failed\r\n");
+            return -1;
+        }
+        shellPrint(shell, "key %s=%d\r\n", argv[2], level);
+        return 0;
+#else
+        shellPrint(shell, "key injection needs CONFIG_MINIAPP_ADB_DEBUG\r\n");
+        return -1;
+#endif
+    }
+
+    if (strcmp(argv[1], "btn") == 0) {
+        /* 模拟板载功能键（侧键）单击：走和真实按键相同的 miniapp_button_click 路径，
+         * 用来验证 on_button_click 的返回逻辑。 */
+        int rc = miniapp_button_click("function");
+        shellPrint(shell, "button click rc=%d\r\n", rc);
+        return 0;
+    }
+
+    if (strcmp(argv[1], "screen") == 0) {
+        miniapp_scene_t *scene = lisa_mem_calloc(1, sizeof(*scene));
+        if (!scene) {
+            shellPrint(shell, "no memory for dump\r\n");
+            return -1;
+        }
+        if (!miniapp_ui_scene_snapshot(scene)) {
+            lisa_mem_free(scene);
+            shellPrint(shell, "no frame presented yet\r\n");
+            return -1;
+        }
+        shellPrint(shell, "bg=%06x shapes=%u texts=%u ordered=%d\r\n",
+                   (unsigned)scene->background, (unsigned)scene->shape_count,
+                   (unsigned)scene->text_count, scene->ordered ? 1 : 0);
+        for (uint16_t i = 0; i < scene->text_count; ++i) {
+            const miniapp_text_t *t = &scene->texts[i];
+            shellPrint(shell, "  T[%u] (%d,%d) %06x \"%s\"\r\n", (unsigned)i, t->x, t->y,
+                       (unsigned)t->color, t->text);
+        }
+        /* 图元多了就"只留尾部"：串口一次只回得到 2~3KB，全量 dump 会被截断，
+         * 而折线图这类逐段绘制的画面，恰恰是末尾几段（收敛的最后位置）最关键。 */
+        uint16_t total = scene->shape_count;
+        uint16_t head = total > 64 ? 0 : total;
+        for (uint16_t i = 0; i < head; ++i) {
+            const miniapp_shape_t *s = &scene->shapes[i];
+            shellPrint(shell, "  S[%u] k=%u (%d,%d) %dx%d %06x\r\n", (unsigned)i, s->kind,
+                       s->x, s->y, s->w, s->h, (unsigned)s->color);
+        }
+        uint16_t start = total > head ? (total > head + 32 ? total - 32 : head) : total;
+        if (start > head) {
+            shellPrint(shell, "  ... %u more, 只显示末尾 %u 条 ...\r\n",
+                       (unsigned)start, (unsigned)(total - start));
+        }
+        for (uint16_t i = start; i < total; ++i) {
+            const miniapp_shape_t *s = &scene->shapes[i];
+            shellPrint(shell, "  S[%u] k=%u (%d,%d) %dx%d %06x\r\n", (unsigned)i, s->kind,
+                       s->x, s->y, s->w, s->h, (unsigned)s->color);
+        }
+        lisa_mem_free(scene);
+        return 0;
+    }
+
+    if (strcmp(argv[1], "list") == 0) {
+        for (size_t i = 0; i < BUILTIN_APP_COUNT; ++i) {
+            shellPrint(shell, "[%u] %-8s size=%-6u tool=%s\r\n", (unsigned)i,
+                       k_builtin_apps[i].id, (unsigned)k_builtin_apps[i].size,
+                       k_builtin_apps[i].tool_name);
+        }
+        return 0;
+    }
+
+    if (strcmp(argv[1], "status") == 0) {
+        builtin_print_status(shell);
+        return 0;
+    }
+
+    if (strcmp(argv[1], "audio") == 0) {
+        miniapp_audio_status_t a = {0};
+        miniapp_get_audio_status(&a);
+        shellPrint(shell,
+                   "synth=%u fail=%u notes=%u last=%u/%ums tones=%u busy=%d\r\n",
+                   (unsigned)a.synth_played, (unsigned)a.synth_failed, (unsigned)a.synth_notes,
+                   (unsigned)a.last_notes, (unsigned)a.last_ms, (unsigned)a.tones, a.busy ? 1 : 0);
+        shellPrint(shell, "tts req=%u ok=%u fail=%u last=%u %s\r\n",
+                   (unsigned)a.tts_requests, (unsigned)a.tts_ok, (unsigned)a.tts_failed,
+                   (unsigned)a.tts_last_id, a.tts_last);
+        return 0;
+    }
+
+    if (strcmp(argv[1], "run") == 0) {
+        if (argc < 3) {
+            shellPrint(shell, "usage: miniapp run <id>\r\n");
+            return -1;
+        }
+        const builtin_app_t *app = builtin_find(argv[2]);
+        if (!app) {
+            shellPrint(shell, "unknown app '%s'\r\n", argv[2]);
+            return -1;
+        }
+
+        miniapp_package_t package = {0};
+        snprintf(package.id, sizeof(package.id), "%s", app->id);
+        snprintf(package.version, sizeof(package.version), "%s", app->version);
+        snprintf(package.name, sizeof(package.name), "%s", app->tool_name);
+        snprintf(package.hash, sizeof(package.hash), "%s", app->hash);
+        package.size = app->size;
+
+        if (!miniapp_install_begin()) {
+            shellPrint(shell, "install busy or runtime unavailable\r\n");
+            return -1;
+        }
+        char error[128] = {0};
+        TickType_t t0 = xTaskGetTickCount();
+        int rc = miniapp_install(&package, (const char *)app->lua, error, sizeof(error));
+        uint32_t cost = (uint32_t)((xTaskGetTickCount() - t0) * portTICK_PERIOD_MS);
+        shellPrint(shell, "install %s rc=%d cost=%ums%s%s\r\n", app->id, rc, (unsigned)cost,
+                   error[0] ? " err=" : "", error);
+        miniapp_install_end();
+        builtin_print_status(shell);
+        return rc == 0 ? 0 : -1;
+    }
+
+    shellPrint(shell, "unknown subcommand '%s'\r\n", argv[1]);
+    return -1;
+}
