+static int miniapp_lua_gpio_read(lua_State *L)
+{
+    /* gpio.read(bank, pin) -> 0/1 (bank "a"|"b"|"d"), -1 on error */
+    const char *bank = luaL_checkstring(L, 1);
+    int pin = (int)luaL_checkinteger(L, 2);
+
+    lisa_device_t *dev = NULL;
+    uint8_t pad = 0;
+    int is_exgpio = 0;
+    int bank_index = -1;
+    if (bank[0] == 'a' || bank[0] == 'A') {
+        dev = lisa_device_get("gpioa");
+        pad = CSK_IOMUX_PAD_A;
+        bank_index = 0;
+    } else if (bank[0] == 'b' || bank[0] == 'B') {
+        dev = lisa_device_get("gpiob");
+        pad = CSK_IOMUX_PAD_B;
+        bank_index = 1;
+    } else if (bank[0] == 'd' || bank[0] == 'D') {
+        dev = lisa_device_get("exgpiod"); /* CH32V003 的 D 端口（扩展口 PD4） */
+        is_exgpio = 1;
+        bank_index = 2;
+    } else {
+        return luaL_error(L, "unknown gpio bank (use 'a', 'b' or 'd')");
+    }
+    if (pin < 0 || pin > 31) {
+        return luaL_error(L, "pin out of range (0..31)");
+    }
+#ifdef CONFIG_MINIAPP_ADB_DEBUG
+    /* Headless debugging: a synthetic level replaces the hardware read. */
+    if (bank_index >= 0 && (s_sim_gpio_mask[bank_index] & (1u << pin))) {
+        lua_pushinteger(L, s_sim_gpio_level[bank_index][pin]);
+        return 1;
+    }
+#endif
+    if (!lisa_device_ready(dev)) {
+        lua_pushinteger(L, -1);
+        return 1;
+    }
+
+    /* 切回 GPIO 功能并配输入下拉，再读电平（复用 4G/UART 引脚作按键输入）。
+     * Mini3 扩展口 GPIO 复用功能号不统一：PA00/PA01 本是 4G 的 EN/RST，
+     * 其 GPIO 功能号是 1；PB06/PB07（UART2）用默认功能 0。若统一用
+     * FUNC_DEFAULT 会把 PA0/PA1 切错功能、读不到电平变化。
+     * 外接按键模块为「高电平有效」：松开 OUT 被模块下拉到低、按下输出高，
+     * 故用输入下拉，空闲读 0、按下读 1。
+     * exgpio（CH32V003）走 I2C 桥接，无需 pinmux，直接读其输入寄存器。 */
+    if (!is_exgpio) {
+        uint32_t iomux_func = CSK_IOMUX_FUNC_DEFAULT;
+        if (pad == CSK_IOMUX_PAD_A && (pin == 0 || pin == 1)) {
+            iomux_func = CSK_IOMUX_FUNC_ALTER1; /* PA00/PA01 GPIO 功能号 = 1 */
+        }
+        /* 首次配置要等下拉建立：引脚刚从 UART/4G 复用功能切过来时，立即读
+         * 会得到瞬时高电平，被 Lua 误判成“按键已按下”（短脚本里会让开局
+         * 直接误触）。这里只在第一次配置时延时并丢弃首个采样。 */
+        bool first = !(s_gpio_ready[bank_index] & (1u << pin));
+        IOMuxManager_PinConfigure(pad, (uint8_t)pin, iomux_func);
+        if (lisa_gpio_configure(dev, (uint32_t)pin, LISA_GPIO_CONFIG_INPUT_PULLDOWN) != 0) {
+            lua_pushinteger(L, -1);
+            return 1;
+        }
+        if (first) {
+            vTaskDelay(pdMS_TO_TICKS(2));
+            (void)lisa_gpio_read_pin(dev, (uint32_t)pin);
+            s_gpio_ready[bank_index] |= (1u << pin);
+        }
+    }
+    int level = lisa_gpio_read_pin(dev, (uint32_t)pin);
+    if (level == LISA_GPIO_HIGH) {
+        lua_pushinteger(L, 1);
+    } else if (level == LISA_GPIO_LOW) {
+        lua_pushinteger(L, 0);
+    } else {
+        lua_pushinteger(L, -1);
+    }
+    return 1;
+}
+
+static int miniapp_lua_adc_read(lua_State *L)
+{
+    /* adc.read(channel) -> raw value (CH32V003 exadc, 0..7), -1 on error */
+    int channel = (int)luaL_checkinteger(L, 1);
+    if (channel < 0 || channel > 7) {
+        return luaL_error(L, "channel out of range (0..7)");
+    }
+#ifdef CONFIG_MINIAPP_ADB_DEBUG
+    if (channel == 7 && s_sim_knob >= 0) {
+        lua_pushinteger(L, s_sim_knob);
+        return 1;
+    }
+#endif
+    lisa_device_t *dev = lisa_device_get("exadc");
+    if (!lisa_device_ready(dev)) {
+        lua_pushinteger(L, -1);
+        return 1;
+    }
+    uint16_t val = 0;
+    if (lisa_adc_read(dev, (uint32_t)channel, &val) != LISA_DEVICE_OK) {
+        lua_pushinteger(L, -1);
+        return 1;
+    }
+    lua_pushinteger(L, (lua_Integer)val);
+    return 1;
+}
