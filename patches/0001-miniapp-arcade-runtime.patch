+typedef struct {
+    char call_id[BUILTIN_CALL_ID_MAX + 1];
+    const builtin_app_t *app;
+} builtin_job_t;
+
+static cJSON *builtin_list(const char *name, const builtin_app_t *app)
+{
+    cJSON *tool = mcp_tool_list_info_create_default(name, app->tool_desc);
+    if (!tool) {
+        return NULL;
+    }
+    /* 无参数工具：additionalProperties 用 JSON 布尔而非字符串。 */
+    cJSON *schema = cJSON_GetObjectItemCaseSensitive(tool, "inputSchema");
+    cJSON_DeleteItemFromObjectCaseSensitive(schema, "additionalProperties");
+    if (!cJSON_AddBoolToObject(schema, "additionalProperties", false)) {
+        cJSON_Delete(tool);
+        return NULL;
+    }
+    return tool;
+}
+
+static void builtin_worker(void *argument)
+{
+    builtin_job_t *job = argument;
+    const builtin_app_t *app = job->app;
+
+    miniapp_package_t package = {0};
+    snprintf(package.id, sizeof(package.id), "%s", app->id);
+    snprintf(package.version, sizeof(package.version), "%s", app->version);
+    snprintf(package.name, sizeof(package.name), "%s", app->tool_name);
+    snprintf(package.hash, sizeof(package.hash), "%s", app->hash);
+    package.size = app->size;
+
+    char error[128] = {0};
+    int rc = miniapp_install(&package, (const char *)app->lua, error, sizeof(error));
+
+    char message[180];
+    if (rc == 0) {
+        snprintf(message, sizeof(message), "%s", app->launch_msg);
+        LISA_LOGI("mcp", "builtin app %s launched (size=%u)", app->id, app->size);
+    } else {
+        snprintf(message, sizeof(message), "miniapp launch failed: %s", error);
+        LISA_LOGW("mcp", "builtin app %s install failed: %s", app->id, error);
+    }
+
+    cJSON *result = miniapp_mcp_result(app->tool_name, message, rc != 0);
+    if (result) {
+        (void)mcp_tool_call_result_response(job->call_id, result);
+        cJSON_Delete(result);
+    }
+    miniapp_install_end();
+    lisa_mem_free(job);
+    vTaskDelete(NULL);
+}
+
+static cJSON *builtin_call(const char *id, const char *name, cJSON *args,
+                           const builtin_app_t *app)
+{
+    if (!id || !id[0] || strlen(id) > BUILTIN_CALL_ID_MAX || !cJSON_IsObject(args)) {
+        return miniapp_mcp_result(name, "invalid call ID or arguments", true);
+    }
+    if (cJSON_GetArraySize(args) != 0) {
+        return miniapp_mcp_result(name, "this tool takes no arguments", true);
+    }
+
+    builtin_job_t *job = lisa_mem_calloc(1, sizeof(*job));
+    if (!job) {
+        return miniapp_mcp_result(name, "not enough memory for launch", true);
+    }
+    memcpy(job->call_id, id, strlen(id) + 1);
+    job->app = app;
+
+    if (!miniapp_install_begin()) {
+        lisa_mem_free(job);
+        return miniapp_mcp_result(name, "miniapp runtime unavailable or install in progress", true);
+    }
+    if (xTaskCreate(builtin_worker, app->task_name, 4096, job, 4, NULL) != pdPASS) {
+        miniapp_install_end();
+        lisa_mem_free(job);
+        return miniapp_mcp_result(name, "failed to start launch worker", true);
+    }
+    return NULL; /* Async response after launch. */
+}
+
+static cJSON *play_dice_list(const char *name) { return builtin_list(name, &k_builtin_apps[0]); }
+static cJSON *play_dice_call(const char *id, const char *name, cJSON *args) {
+    return builtin_call(id, name, args, &k_builtin_apps[0]);
+}
