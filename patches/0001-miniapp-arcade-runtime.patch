+/* 内置小应用描述：工具名、源码、启动文案，全部集中在这里。 */
+typedef struct {
+    const char *id;
+    const char *version;
+    const char *hash;
+    const unsigned char *lua;
+    uint32_t size;
+    const char *tool_name;
+    const char *tool_desc;
+    const char *launch_msg;
+    const char *task_name;
+} builtin_app_t;
