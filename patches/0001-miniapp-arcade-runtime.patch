diff --git a/src/shell/cmd/hwtest.c b/src/shell/cmd/hwtest.c
new file mode 100644
index 00000000..791c1c3b
--- /dev/null
+++ b/src/shell/cmd/hwtest.c
@@ -0,0 +1,216 @@
+/*
+ * hwtest.c - 扩展外设接线自检命令
+ *
+ * 用法:
+ *   hwtest btn  [count]   连读 PA1(gpioa pin1) 电平, 验证按钮
+ *   hwtest knob [count]   连读 PD4(exadc ch7) ADC, 验证旋钮
+ */
+
+#include "shell.h"
+#include <stdlib.h>
+#include <string.h>
+#include "FreeRTOS.h"
+#include "task.h"
+#include "lisa_gpio.h"
+#include "lisa_adc.h"
+#include "lisa_device.h"
+#include "IOMuxManager.h"
+
+/* 按钮: 扩展排针 PA01 -> 主 SoC gpioa pin1 (原 4G RST 功能) */
+#define HW_BTN_GPIO_DEV "gpioa"
+#define HW_BTN_PAD      CSK_IOMUX_PAD_A
+#define HW_BTN_PIN      1
+
+/* 旋钮: 扩展排针 PD4 -> CH32V003 exadc 通道 7 */
+#define HW_KNOB_ADC_DEV "exadc"
+#define HW_KNOB_ADC_CH  7
+
+#define HW_SAMPLE_MS     150
+#define HW_DEFAULT_COUNT 30
+#define HW_MAX_COUNT     500
+
+static int hwtest_btn(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+    int count = HW_DEFAULT_COUNT;
+
+    if (argc >= 3) {
+        count = atoi(argv[2]);
+    }
+    if (count <= 0 || count > HW_MAX_COUNT) {
+        count = HW_DEFAULT_COUNT;
+    }
+
+    lisa_device_t *gpio = lisa_device_get(HW_BTN_GPIO_DEV);
+    if (!lisa_device_ready(gpio)) {
+        shellPrint(shell, "gpio device '%s' not ready\r\n", HW_BTN_GPIO_DEV);
+        return -1;
+    }
+
+    /* PA1 是 4G RST 功能，其 GPIO 复用功能号是 1（ALTER1），不是 FUNC_DEFAULT。
+     * 外接按键模块为「高电平有效」：松开 OUT 被下拉到低、按下输出高，故用输入下拉。 */
+    int32_t mux = IOMuxManager_PinConfigure(HW_BTN_PAD, HW_BTN_PIN, CSK_IOMUX_FUNC_ALTER1);
+    shellPrint(shell, "pinmux PA%d -> GPIO func1(ALTER1), ret=%d\r\n", HW_BTN_PIN, (int)mux);
+
+    int cfg = lisa_gpio_configure(gpio, HW_BTN_PIN, LISA_GPIO_CONFIG_INPUT_PULLDOWN);
+    shellPrint(shell, "configure PA%d input+pulldown, ret=%d\r\n", HW_BTN_PIN, cfg);
+
+    shellPrint(shell, "sampling PA%d every %dms x%d (press/release the button)\r\n", HW_BTN_PIN, HW_SAMPLE_MS,
+               count);
+
+    for (int i = 0; i < count; i++) {
+        int level = lisa_gpio_read_pin(gpio, HW_BTN_PIN);
+        if (level < 0) {
+            shellPrint(shell, "[%03d] PA%d read err=%d\r\n", i, HW_BTN_PIN, level);
+        } else {
+            shellPrint(shell, "[%03d] PA%d = %d  %s\r\n", i, HW_BTN_PIN, level,
+                       level == LISA_GPIO_LOW ? "(LOW / pressed)" : "(HIGH / released)");
+        }
+        vTaskDelay(pdMS_TO_TICKS(HW_SAMPLE_MS));
+    }
+    return 0;
+}
+
+static int hwtest_knob(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+    int count = HW_DEFAULT_COUNT;
+
+    if (argc >= 3) {
+        count = atoi(argv[2]);
+    }
+    if (count <= 0 || count > HW_MAX_COUNT) {
+        count = HW_DEFAULT_COUNT;
+    }
+
+    lisa_device_t *adc = lisa_device_get(HW_KNOB_ADC_DEV);
+    if (!lisa_device_ready(adc)) {
+        shellPrint(shell, "adc device '%s' not ready\r\n", HW_KNOB_ADC_DEV);
+        return -1;
+    }
+
+    shellPrint(shell, "sampling exadc ch%d (PD4) every %dms x%d (turn the knob)\r\n", HW_KNOB_ADC_CH, HW_SAMPLE_MS,
+               count);
+
+    for (int i = 0; i < count; i++) {
+        uint16_t val = 0;
+        int ret = lisa_adc_read(adc, HW_KNOB_ADC_CH, &val);
+        if (ret != LISA_DEVICE_OK) {
+            shellPrint(shell, "[%03d] adc read err=%d\r\n", i, ret);
+        } else {
+            shellPrint(shell, "[%03d] ADC = %4u (0x%03X)\r\n", i, (unsigned)val, (unsigned)val);
+        }
+        vTaskDelay(pdMS_TO_TICKS(HW_SAMPLE_MS));
+    }
+    return 0;
+}
+
+static int hwtest_adc(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+    int count = HW_DEFAULT_COUNT;
+
+    if (argc >= 3) {
+        count = atoi(argv[2]);
+    }
+    if (count <= 0 || count > HW_MAX_COUNT) {
+        count = HW_DEFAULT_COUNT;
+    }
+
+    lisa_device_t *adc = lisa_device_get(HW_KNOB_ADC_DEV);
+    if (!lisa_device_ready(adc)) {
+        shellPrint(shell, "adc device '%s' not ready\r\n", HW_KNOB_ADC_DEV);
+        return -1;
+    }
+
+    shellPrint(shell, "sampling all 8 exadc channels every %dms x%d\r\n", HW_SAMPLE_MS, count);
+
+    for (int i = 0; i < count; i++) {
+        shellPrint(shell, "[%03d] ", i);
+        for (int ch = 0; ch < 8; ch++) {
+            uint16_t val = 0;
+            int ret = lisa_adc_read(adc, (uint32_t)ch, &val);
+            if (ret == LISA_DEVICE_OK) {
+                shellPrint(shell, "ch%d=%4u ", ch, (unsigned)val);
+            } else {
+                shellPrint(shell, "ch%d=ERR ", ch);
+            }
+        }
+        shellPrint(shell, "\r\n");
+        vTaskDelay(pdMS_TO_TICKS(HW_SAMPLE_MS));
+    }
+    return 0;
+}
+
+static int hwtest_gpio(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+    int count = HW_DEFAULT_COUNT;
+
+    if (argc >= 3) {
+        count = atoi(argv[2]);
+    }
+    if (count <= 0 || count > HW_MAX_COUNT) {
+        count = HW_DEFAULT_COUNT;
+    }
+
+    lisa_device_t *gpa = lisa_device_get("gpioa");
+    lisa_device_t *gpb = lisa_device_get("gpiob");
+    if (!lisa_device_ready(gpa) || !lisa_device_ready(gpb)) {
+        shellPrint(shell, "gpio device not ready\r\n");
+        return -1;
+    }
+
+    /* 4 个扩展口 GPIO：PA0/PA1 用 func1(ALTER1)+下拉；PB6/PB7 用 func0(DEFAULT)+下拉 */
+    IOMuxManager_PinConfigure(CSK_IOMUX_PAD_A, 0, CSK_IOMUX_FUNC_ALTER1);
+    lisa_gpio_configure(gpa, 0, LISA_GPIO_CONFIG_INPUT_PULLDOWN);
+    IOMuxManager_PinConfigure(CSK_IOMUX_PAD_A, 1, CSK_IOMUX_FUNC_ALTER1);
+    lisa_gpio_configure(gpa, 1, LISA_GPIO_CONFIG_INPUT_PULLDOWN);
+    IOMuxManager_PinConfigure(CSK_IOMUX_PAD_B, 6, CSK_IOMUX_FUNC_DEFAULT);
+    lisa_gpio_configure(gpb, 6, LISA_GPIO_CONFIG_INPUT_PULLDOWN);
+    IOMuxManager_PinConfigure(CSK_IOMUX_PAD_B, 7, CSK_IOMUX_FUNC_DEFAULT);
+    lisa_gpio_configure(gpb, 7, LISA_GPIO_CONFIG_INPUT_PULLDOWN);
+
+    shellPrint(shell, "sampling PA0/PA1/PB6/PB7 every %dms x%d (press button on ONE pin)\r\n",
+               HW_SAMPLE_MS, count);
+
+    for (int i = 0; i < count; i++) {
+        int a0 = lisa_gpio_read_pin(gpa, 0);
+        int a1 = lisa_gpio_read_pin(gpa, 1);
+        int b6 = lisa_gpio_read_pin(gpb, 6);
+        int b7 = lisa_gpio_read_pin(gpb, 7);
+        shellPrint(shell, "[%03d] PA0=%d PA1=%d PB6=%d PB7=%d\r\n", i, a0, a1, b6, b7);
+        vTaskDelay(pdMS_TO_TICKS(HW_SAMPLE_MS));
+    }
+    return 0;
+}
+
+static int cmd_hwtest(int argc, char **argv)
+{
+    Shell *shell = shellGetCurrent();
+
+    if (argc < 2) {
+        shellPrint(shell, "usage:\r\n");
+        shellPrint(shell, "  hwtest btn  [count]   sample PA1 button, default 30 times\r\n");
+        shellPrint(shell, "  hwtest knob [count]   sample PD4 knob ADC, default 30 times\r\n");
+        shellPrint(shell, "  hwtest adc  [count]   sample all 8 exadc channels, default 30 times\r\n");
+        shellPrint(shell, "  hwtest gpio [count]   sample PA0/PA1/PB6/PB7, default 30 times\r\n");
+        return -1;
+    }
+
+    if (strcmp(argv[1], "btn") == 0) {
+        return hwtest_btn(argc, argv);
+    } else if (strcmp(argv[1], "knob") == 0) {
+        return hwtest_knob(argc, argv);
+    } else if (strcmp(argv[1], "adc") == 0) {
+        return hwtest_adc(argc, argv);
+    } else if (strcmp(argv[1], "gpio") == 0) {
+        return hwtest_gpio(argc, argv);
+    }
+
+    shellPrint(shell, "unknown subcommand '%s'\r\n", argv[1]);
+    return -1;
+}
+
+SHELL_EXPORT_CMD(SHELL_CMD_PERMISSION(0) | SHELL_CMD_TYPE(SHELL_TYPE_CMD_MAIN) | SHELL_CMD_DISABLE_RETURN, hwtest,
+                 cmd_hwtest, "hwtest btn|knob - check external button/knob wiring");
diff --git a/src/shell/cmd/mcplist.c b/src/shell/cmd/mcplist.c
new file mode 100644
index 00000000..9a4c61c6
--- /dev/null
+++ b/src/shell/cmd/mcplist.c
@@ -0,0 +1,48 @@
+#include "shell.h"
+#include "mcp.h"
+#include "cJSON.h"
+
+extern const struct mcp_tool __mcp_tool_start[];
+extern const struct mcp_tool __mcp_tool_end[];
+
+static int cmd_mcplist(int argc, char **argv)
+{
+    (void)argc;
+    (void)argv;
+    Shell *shell = shellGetCurrent();
+
+    int count = 0;
+    for (const struct mcp_tool *tool = __mcp_tool_start; tool < __mcp_tool_end; tool++) {
+        shellPrint(shell, "[section] %s\r\n", tool->name ? tool->name : "(null)");
+        count++;
+    }
+    shellPrint(shell, "section total=%d\r\n", count);
+
+    cJSON *msg = cJSON_Parse("{\"method\":\"tools/list\",\"id\":\"mcpdebug\"}");
+    if (!msg) {
+        shellPrint(shell, "parse failed\r\n");
+        return 0;
+    }
+    cJSON *resp = mcp_process(msg);
+    cJSON_Delete(msg);
+    if (!resp) {
+        shellPrint(shell, "mcp_process returned NULL\r\n");
+        return 0;
+    }
+    cJSON *result = cJSON_GetObjectItemCaseSensitive(resp, "result");
+    cJSON *tools = result ? cJSON_GetObjectItemCaseSensitive(result, "tools") : NULL;
+    int tcount = tools ? cJSON_GetArraySize(tools) : -1;
+    shellPrint(shell, "tools/list count=%d\r\n", tcount);
+    if (tools) {
+        cJSON *item = NULL;
+        cJSON_ArrayForEach(item, tools) {
+            cJSON *name = cJSON_GetObjectItemCaseSensitive(item, "name");
+            shellPrint(shell, "  [list] %s\r\n", name && name->valuestring ? name->valuestring : "(null)");
+        }
+    }
+    cJSON_Delete(resp);
+    return 0;
+}
+
+SHELL_EXPORT_CMD(SHELL_CMD_PERMISSION(0) | SHELL_CMD_TYPE(SHELL_TYPE_CMD_MAIN) | SHELL_CMD_DISABLE_RETURN, mcplist,
+                 cmd_mcplist, list all registered MCP tools);
