+/* Console diagnostics: copy the last presented scene so the screen content can be
+ * read over ADB (headless verification of what the user sees). */
+bool miniapp_ui_scene_snapshot(miniapp_scene_t *out)
+{
+    if (!out || !s_pending_scene || !s_scene_lock) {
+        return false;
+    }
+    xSemaphoreTake(s_scene_lock, portMAX_DELAY);
+    bool ok = s_scene_sequence != 0;
+    if (ok) {
+        miniapp_scene_copy(out, s_pending_scene);
+    }
+    xSemaphoreGive(s_scene_lock);
+    return ok;
+}
+
