+/* ---------------- 开发期控制台命令（ADB 调试用） ----------------
+ * 语音链路要等模型，排查时太慢。这里直接从 console 装内置小应用，
+ * 并打印安装耗时/帧计数/最后一条 Lua 错误。 */
+#define BUILTIN_APP_COUNT (sizeof(k_builtin_apps) / sizeof(k_builtin_apps[0]))
+
+static const builtin_app_t *builtin_find(const char *name)
+{
+    for (size_t i = 0; i < BUILTIN_APP_COUNT; ++i) {
+        if (strcmp(k_builtin_apps[i].id, name) == 0 ||
+            strcmp(k_builtin_apps[i].tool_name, name) == 0) {
+            return &k_builtin_apps[i];
+        }
+    }
+    return NULL;
+}
+
+static void builtin_print_status(Shell *shell)
+{
+    miniapp_status_t st;
+    miniapp_get_status(&st);
+    shellPrint(shell, "installed=%d active=%d size=%u frames=%u dropped=%u last=%ums max=%ums\r\n",
+               st.installed ? 1 : 0, st.active ? 1 : 0, (unsigned)st.source_size,
+               (unsigned)st.frames, (unsigned)st.dropped_frames,
+               (unsigned)st.last_frame_ms, (unsigned)st.max_frame_ms);
+    if (st.last_error[0]) {
+        shellPrint(shell, "last_error: %s\r\n", st.last_error);
+    }
+}
